# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Segurança: chave AES-256-GCM (64 caracteres hexadecimais).
# Gere com: openssl rand -hex 32   — chaves triviais (ex.: só zeros) são rejeitadas.
APP_ENCRYPTION_KEY=
# Rotação: incremente a versão, mova a chave antiga para APP_ENCRYPTION_KEY_V<n> e
# recadastre as chaves BYOK quando quiser aposentar a versão antiga.
APP_ENCRYPTION_KEY_VERSION=1
# APP_ENCRYPTION_KEY_V1=

# URL pública da aplicação (snippets MCP, links de convite e proteção DNS rebinding do MCP)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Hosts extras aceitos pelo endpoint MCP (separados por vírgula), ex.: localhost:3000
MCP_ALLOWED_HOSTS=

# Apenas para scripts/create-test-user.mjs
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=

# Apenas para scripts/eval-ai-provider.mjs (avaliação de modelos NVIDIA Nemotron).
# No app, a chave é cadastrada em Settings > Chaves de IA e fica criptografada no banco.
# NVIDIA_API_KEY=
